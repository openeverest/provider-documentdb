## Location to install dependencies to
LOCALBIN ?= $(shell pwd)/bin
$(LOCALBIN):
	mkdir -p $(LOCALBIN)

# CONTAINER_TOOL defines the container tool to be used for building images.
CONTAINER_TOOL ?= docker

# OpenEverest branch to use for OpenEverest CRD installation.
OPENEVEREST_BRANCH ?= main

# DocumentDB operator release the chart bundles (the dependency version in
# charts/provider-documentdb/Chart.yaml) and the CloudNativePG release that
# operator bundles. Integration tests install their CRDs without the operators.
DOCUMENTDB_OPERATOR_VERSION ?= 1.2.1
CNPG_VERSION ?= 1.29.1

# Image URL to use for building/pushing image targets
IMG ?= ghcr.io/openeverest/provider-documentdb-dev:latest

# Image URL for OpenEverest controller used in integration tests (must be pre-built).
OPENEVEREST_CONTROLLER_IMG ?= ghcr.io/openeverest/openeverest-controller-dev:0.0.0

# Split IMG into repository and tag for Helm values, at the last colon so a
# registry port (localhost:5000/...) stays in the repository.
_IMG_TAG  = $(lastword $(subst :, ,$(IMG)))
_IMG_REPO = $(patsubst %:$(_IMG_TAG),%,$(IMG))

# k3d cluster config, and its name (must match the config's metadata.name).
# The e2e-cluster tests use test/e2e-cluster/k3d_config.yaml.
K3D_CONFIG ?= ./dev/k3d_config.yaml
K3D_CLUSTER_NAME ?= provider-documentdb-test

# Image mode of the DocumentDB operator in the e2e-cluster tests: auto,
# imageVolume or combined (the chart's operator.imageMode).
DOCUMENTDB_IMAGE_MODE ?= auto

# Pull policy of the provider image in the e2e-cluster tests: Never for an
# image imported into k3d, Always for one in a registry.
PROVIDER_IMAGE_PULL_POLICY ?= Never

# Released chart the e2e-cluster upgrade test starts from.
PREVIOUS_CHART_VERSION ?= 0.1.0

# DocumentDB operator release the e2e-cluster operator-upgrade test starts
# from, before upgrading to DOCUMENTDB_OPERATOR_VERSION; and the version
# deploy-operator installs.
PREVIOUS_OPERATOR_VERSION ?= 1.2.0
OPERATOR_VERSION ?= $(DOCUMENTDB_OPERATOR_VERSION)

# cert-manager, which the DocumentDB operator needs, and the CSI hostpath
# driver the e2e-cluster tests grow volumes with (k3d's local-path can't).
CERT_MANAGER_VERSION ?= v1.21.3
EXTERNAL_SNAPSHOTTER_VERSION ?= v8.7.1
CSI_HOSTPATH_VERSION ?= v1.19.0

# controller-gen version
CONTROLLER_TOOLS_VERSION ?= v0.18.0
CONTROLLER_GEN ?= $(LOCALBIN)/controller-gen-$(CONTROLLER_TOOLS_VERSION)

# yq version for YAML processing
YQ_VERSION ?= v4.44.6
YQ ?= $(LOCALBIN)/yq-$(YQ_VERSION)

# golangci-lint version
GOLANGCI_LINT_VERSION ?= v2.14.0
GOLANGCI_LINT ?= $(LOCALBIN)/golangci-lint-$(GOLANGCI_LINT_VERSION)

# Helm chart directory
CHART_DIR ?= charts/provider-documentdb

.PHONY: help
help: ## Display this help.
	@awk 'BEGIN {FS = ":.*##"; printf "\nUsage:\n  make \033[36m<target>\033[0m\n"} /^[a-zA-Z_0-9-]+:.*?##/ { printf "  \033[36m%-20s\033[0m %s\n", $$1, $$2 } /^##@/ { printf "\n\033[1m%s\033[0m\n", substr($$0, 5) } ' $(MAKEFILE_LIST)

##@ Development

.PHONY: run
run: generate ## Run the provider locally, without the admission webhook (it needs the chart's certificate).
	go run cmd/provider/main.go --admission=false

.PHONY: lint
lint: golangci-lint ## Run golangci-lint.
	$(GOLANGCI_LINT) run

.PHONY: test-unit
test-unit: ## Run unit tests.
	go test -race ./... -coverprofile cover.out

##@ Code Generation

.PHONY: manifests
manifests: controller-gen ## Generate RBAC manifests using controller-gen from kubebuilder markers.
	$(CONTROLLER_GEN) rbac:roleName=manager-role paths="./..." output:rbac:dir=config/rbac
	@{ \
		echo '# This file is generated by controller-gen from kubebuilder RBAC markers.'; \
		echo '# Do not edit manually. Run `make manifests` to regenerate.'; \
		echo '#'; \
		echo '# Source markers are in internal/provider/rbac.go and other .go files'; \
		echo '# with +kubebuilder:rbac annotations.'; \
		if grep -q '^---' config/rbac/role.yaml; then sed -n '/^---/,$$p' config/rbac/role.yaml; else cat config/rbac/role.yaml; fi; \
	} > config/rbac/role.yaml.tmp
	@mv config/rbac/role.yaml.tmp config/rbac/role.yaml

.PHONY: operator-crds
operator-crds: ## Copy the CRDs of the DocumentDB operator version pinned in go.mod.
	go mod download github.com/documentdb/documentdb-operator
	@cat "$$(go list -m -f '{{.Dir}}' github.com/documentdb/documentdb-operator)"/config/crd/bases/documentdb.io_*.yaml > internal/operatorcrds/crd.yaml

.PHONY: helm-sync-rbac
helm-sync-rbac: yq ## Sync generated RBAC rules into the Helm chart.
	@echo "Syncing RBAC rules from config/rbac/role.yaml to Helm chart..."
	@{ \
		echo '# This file is generated by `make helm-sync-rbac` from config/rbac/role.yaml.'; \
		echo '# Do not edit manually. Run `make generate` to update.'; \
		$(YQ) '.rules' config/rbac/role.yaml; \
	} > $(CHART_DIR)/generated/rbac-rules.yaml
	@echo "Done."

.PHONY: generate
generate: manifests operator-crds helm-sync-rbac ## Run all code generation (RBAC + operator CRDs + Helm sync + provider spec, incl. spec.monitoring, from definition/).
	go generate ./...
	@echo "All generation complete."

.PHONY: verify
verify: ## Verify that generated files are up-to-date (for CI).
	@$(MAKE) generate
	@if git diff --quiet -- config/ definition/ internal/operatorcrds/ $(CHART_DIR)/generated/; then \
		echo "Generated files are up-to-date."; \
	else \
		echo "ERROR: Generated files are out of date. Run 'make generate' and commit the changes."; \
		git diff -- config/ definition/ $(CHART_DIR)/generated/; \
		git diff --stat -- internal/operatorcrds/; \
		exit 1; \
	fi

##@ Build

.PHONY: build
build: generate ## Build provider binary.
	go build -o bin/provider cmd/provider/main.go

.PHONY: docker-build
docker-build: ## Build docker image.
	$(CONTAINER_TOOL) build -t ${IMG} .

.PHONY: docker-push
docker-push: ## Push docker image.
	$(CONTAINER_TOOL) push ${IMG}

##@ Helm

.PHONY: helm-deps
helm-deps: ## Download/update Helm chart dependencies.
	helm dependency build $(CHART_DIR)

.PHONY: helm-install
helm-install: helm-deps ## Install the provider using Helm.
	helm install provider-documentdb $(CHART_DIR) --create-namespace

.PHONY: helm-upgrade
helm-upgrade: helm-deps ## Upgrade the provider using Helm.
	helm upgrade provider-documentdb $(CHART_DIR)

.PHONY: helm-uninstall
helm-uninstall: ## Uninstall the provider using Helm.
	helm uninstall provider-documentdb

.PHONY: helm-template
helm-template: helm-deps ## Render Helm chart templates locally (dry-run).
	# The operator subchart refuses to render without cert-manager's API.
	helm template provider-documentdb $(CHART_DIR) --api-versions cert-manager.io/v1/Certificate

##@ Testing

# Integration tests use chainsaw (https://kyverno.github.io/chainsaw/).
# Install it locally with: go install github.com/kyverno/chainsaw@latest
# Each suite is a directory under test/integration/ — see test/integration/README.md.

.PHONY: test-integration
test-integration: ## Run all integration tests against the current cluster.
	. ./test/vars.sh && chainsaw test --config ./test/integration/.chainsaw.yaml ./test/integration

.PHONY: test-integration-core
test-integration-core: ## Run core integration tests.
	. ./test/vars.sh && chainsaw test --config ./test/integration/.chainsaw.yaml ./test/integration/core

.PHONY: load-image
load-image: ## Import the provider image (IMG) into the k3d cluster.
	k3d image import ${IMG} -c ${K3D_CLUSTER_NAME}

.PHONY: load-openeverest-controller-image
load-openeverest-controller-image: ## Import the OpenEverest controller image into the k3d cluster.
	k3d image import ${OPENEVEREST_CONTROLLER_IMG} -c ${K3D_CLUSTER_NAME}

.PHONY: install-core-crds
install-core-crds: ## Install the OpenEverest CRDs of the core version pinned in go.mod.
	# The CRDs of the core release go.mod pins, so the tests run against the API the provider is built for.
	go mod download github.com/openeverest/openeverest/v2
	kubectl apply --server-side --force-conflicts -f "$$(go list -m -f '{{.Dir}}' github.com/openeverest/openeverest/v2)/config/crd/bases"

.PHONY: install-crds
install-crds: install-core-crds ## Install the OpenEverest CRDs and, for tests without the operators, their CRDs.
	# The DocumentDB operator's CRDs and the CloudNativePG Cluster it creates.
	for crd in dbs backups scheduledbackups; do \
		kubectl apply --server-side -f https://raw.githubusercontent.com/documentdb/documentdb-kubernetes-operator/$(DOCUMENTDB_OPERATOR_VERSION)/operator/documentdb-helm-chart/crds/documentdb.io_$$crd.yaml; \
	done
	kubectl apply --server-side -f https://raw.githubusercontent.com/cloudnative-pg/cloudnative-pg/v$(CNPG_VERSION)/config/crd/bases/postgresql.cnpg.io_clusters.yaml

.PHONY: deploy-provider-ci
deploy-provider-ci: helm-deps ## Deploy the provider via Helm for CI (IMG must already be imported into k3d).
	# Without the operator: integration tests simulate it by patching the
	# status of the resources it would reconcile. install-crds brings its CRDs.
	helm upgrade --install provider-documentdb $(CHART_DIR) \
		--create-namespace \
		--namespace provider-system \
		--set image.repository=$(_IMG_REPO) \
		--set image.tag=$(_IMG_TAG) \
		--set image.pullPolicy=Never \
		--set operator.enabled=false \
		--wait --timeout 2m

# End-to-end tests run the real DocumentDB operator and CloudNativePG: see
# test/e2e-cluster/README.md.

.PHONY: test-e2e-cluster
test-e2e-cluster: ## Run the e2e-cluster tests against the provider deploy-provider-e2e deployed (all but the upgrade suites).
	. ./test/vars.sh && chainsaw test --config ./test/e2e-cluster/.chainsaw.yaml \
		--test-dir ./test/e2e-cluster/lifecycle --test-dir ./test/e2e-cluster/tls

.PHONY: test-e2e-cluster-lifecycle
test-e2e-cluster-lifecycle: ## Run the e2e-cluster lifecycle test.
	. ./test/vars.sh && chainsaw test --config ./test/e2e-cluster/.chainsaw.yaml ./test/e2e-cluster/lifecycle

.PHONY: test-e2e-cluster-upgrade
test-e2e-cluster-upgrade: ## Run the e2e-cluster upgrade test (the previous release deployed by deploy-provider-previous).
	. ./test/vars.sh && IMG=$(IMG) PREVIOUS_CHART_VERSION=$(PREVIOUS_CHART_VERSION) \
		chainsaw test --config ./test/e2e-cluster/.chainsaw.yaml ./test/e2e-cluster/upgrade

.PHONY: test-e2e-cluster-operator-upgrade
test-e2e-cluster-operator-upgrade: ## Run the e2e-cluster operator-upgrade test (the operator deployed by deploy-provider-operator-previous).
	. ./test/vars.sh && PREVIOUS_OPERATOR_VERSION=$(PREVIOUS_OPERATOR_VERSION) \
		OPERATOR_VERSION=$(OPERATOR_VERSION) \
		chainsaw test --config ./test/e2e-cluster/.chainsaw.yaml ./test/e2e-cluster/operator-upgrade

.PHONY: test-e2e-cluster-tls
test-e2e-cluster-tls: ## Run the e2e-cluster TLS test.
	. ./test/vars.sh && chainsaw test --config ./test/e2e-cluster/.chainsaw.yaml ./test/e2e-cluster/tls

.PHONY: deploy-cert-manager
deploy-cert-manager: ## Install cert-manager (CERT_MANAGER_VERSION) and wait for it.
	kubectl apply --server-side -f https://github.com/cert-manager/cert-manager/releases/download/$(CERT_MANAGER_VERSION)/cert-manager.yaml
	kubectl -n cert-manager wait --for=condition=Available deployment --all --timeout=5m

.PHONY: install-csi-hostpath
install-csi-hostpath: ## Install the CSI hostpath driver as the default StorageClass, with volume expansion.
	tmp=$$(mktemp -d) && \
	git clone --quiet --depth 1 --branch $(EXTERNAL_SNAPSHOTTER_VERSION) https://github.com/kubernetes-csi/external-snapshotter.git $$tmp/snapshotter && \
	kubectl kustomize $$tmp/snapshotter/client/config/crd | kubectl apply --server-side -f - && \
	kubectl -n kube-system kustomize $$tmp/snapshotter/deploy/kubernetes/snapshot-controller | kubectl apply --server-side -f - && \
	git clone --quiet --depth 1 --branch $(CSI_HOSTPATH_VERSION) https://github.com/kubernetes-csi/csi-driver-host-path.git $$tmp/hostpath && \
	$$tmp/hostpath/deploy/kubernetes-latest/deploy.sh && \
	rm -rf $$tmp
	kubectl apply -f test/e2e-cluster/storageclass.yaml
	kubectl patch storageclass local-path -p '{"metadata":{"annotations":{"storageclass.kubernetes.io/is-default-class":"false"}}}'

.PHONY: deploy-provider-e2e
deploy-provider-e2e: helm-deps ## Deploy the provider with the DocumentDB operator for the e2e-cluster tests (IMG imported into k3d).
	helm upgrade --install provider-documentdb $(CHART_DIR) \
		--create-namespace \
		--namespace provider-system \
		--set image.repository=$(_IMG_REPO) \
		--set image.tag=$(_IMG_TAG) \
		--set image.pullPolicy=$(PROVIDER_IMAGE_PULL_POLICY) \
		--set operator.imageMode=$(DOCUMENTDB_IMAGE_MODE) \
		--wait --timeout 10m

.PHONY: deploy-provider-previous
deploy-provider-previous: ## Deploy the released chart PREVIOUS_CHART_VERSION with the DocumentDB operator, for the e2e-cluster upgrade test.
	helm upgrade --install provider-documentdb oci://ghcr.io/openeverest/charts/provider-documentdb \
		--version $(PREVIOUS_CHART_VERSION) \
		--create-namespace \
		--namespace provider-system \
		--set operator.imageMode=$(DOCUMENTDB_IMAGE_MODE) \
		--wait --timeout 10m

.PHONY: deploy-operator
deploy-operator: ## Install or upgrade the DocumentDB operator chart OPERATOR_VERSION on its own, with its CRDs, configured as the provider chart configures it.
	helm show crds oci://ghcr.io/documentdb/documentdb-operator --version $(OPERATOR_VERSION) \
		| kubectl apply --server-side --force-conflicts -f -
	helm upgrade --install documentdb-operator oci://ghcr.io/documentdb/documentdb-operator \
		--version $(OPERATOR_VERSION) \
		--create-namespace \
		--namespace documentdb-operator \
		--set imageMode=$(DOCUMENTDB_IMAGE_MODE) \
		--set-string 'cloudnative-pg.config.data.INHERITED_LABELS=core.openeverest.io/*' \
		--wait --timeout 10m

.PHONY: deploy-provider-operator-previous
deploy-provider-operator-previous: helm-deps ## Deploy the DocumentDB operator PREVIOUS_OPERATOR_VERSION on its own, and the provider without one, for the e2e-cluster operator-upgrade test.
	$(MAKE) deploy-operator OPERATOR_VERSION=$(PREVIOUS_OPERATOR_VERSION)
	helm upgrade --install provider-documentdb $(CHART_DIR) \
		--create-namespace \
		--namespace provider-system \
		--set image.repository=$(_IMG_REPO) \
		--set image.tag=$(_IMG_TAG) \
		--set image.pullPolicy=$(PROVIDER_IMAGE_PULL_POLICY) \
		--set operator.enabled=false \
		--wait --timeout 10m

##@ Local Development Cluster

.PHONY: k3d-cluster-up
k3d-cluster-up: ## Create a local k3d cluster for development.
	$(info Creating k3d cluster for testing)
	k3d cluster create --config $(K3D_CONFIG)

.PHONY: k3d-cluster-down
k3d-cluster-down: ## Delete the local k3d cluster.
	$(info Destroying k3d test cluster)
	k3d cluster delete --config $(K3D_CONFIG)

.PHONY: k3d-cluster-reset
k3d-cluster-reset: k3d-cluster-down k3d-cluster-up ## Reset the local k3d cluster.

##@ Tilt Development

.PHONY: dev-up
dev-up: k3d-cluster-up ## Create the k3d cluster and start the Tilt dev environment.
	tilt up -f dev/Tiltfile

.PHONY: dev-down
dev-down: ## Stop the Tilt dev environment (keeps the cluster).
	tilt down -f dev/Tiltfile

.PHONY: dev-destroy
dev-destroy: k3d-cluster-down ## Stop Tilt and delete the k3d cluster.

##@ Tool Dependencies

.PHONY: controller-gen
controller-gen: $(CONTROLLER_GEN) ## Install controller-gen.
$(CONTROLLER_GEN): $(LOCALBIN)
	$(call go-install-tool,$(CONTROLLER_GEN),sigs.k8s.io/controller-tools/cmd/controller-gen,$(CONTROLLER_TOOLS_VERSION))

.PHONY: yq
yq: $(YQ) ## Install yq.
$(YQ): $(LOCALBIN)
	@echo "Installing yq $(YQ_VERSION)..."
	@GOBIN=$(LOCALBIN) go install github.com/mikefarah/yq/v4@$(YQ_VERSION) && mv $(LOCALBIN)/yq $(YQ)

.PHONY: golangci-lint
golangci-lint: $(GOLANGCI_LINT) ## Install golangci-lint.
$(GOLANGCI_LINT): $(LOCALBIN)
	$(call go-install-tool,$(GOLANGCI_LINT),github.com/golangci/golangci-lint/v2/cmd/golangci-lint,$(GOLANGCI_LINT_VERSION))

# go-install-tool will 'go install' any package with custom target and target name. Usage:
# $(call go-install-tool,<target>,<package>,<version>)
define go-install-tool
@[ -f $(1) ] || { \
set -e; \
package=$(2)@$(3); \
echo "Installing $${package}"; \
GOBIN=$(LOCALBIN) go install $${package}; \
mv -f $$(echo "$(1)" | sed "s/-$(3)$$//") $(1); \
}
endef
